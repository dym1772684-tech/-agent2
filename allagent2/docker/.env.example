# ============================================================
# 环境变量模板（提交到仓库；不含任何真实密钥）
# 复制为 .env 后填入自己的值：cp .env.example .env
# ============================================================

# ---- 应用密钥 ----
# 生成方式：openssl rand -hex 32
SECRET_KEY=<请生成64位hex>
ALGORITHM=HS256
# 生成方式：openssl rand -hex 24
AGENT_CONTEXT_SECRET=<请生成48位hex>

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- MySQL ----
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=<设一个强密码>
MYSQL_DATABASE=agent_demo

# ---- 大模型（vLLM / DeepSeek 二选一）----
# 本地 vLLM（WSL）：OPENAI_BASE_URL=http://host.docker.internal:8005/v1
# 云端 DeepSeek：OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=local
OPENAI_BASE_URL=http://host.docker.internal:8005/v1
OPENAI_MODEL=qwen2.5-3b-awq
WEATHER_API_KEY=<你的和风/天气key>

# ---- MCP（同容器 localhost）----
MCP_ELDER_URL=http://127.0.0.1:8001/mcp
MCP_LIFE_URL=http://127.0.0.1:8002/mcp

# ---- 拓扑 / 向量 / HuggingFace ----
AGENT_TOPOLOGY=team
RAG_PERSIST_DIR=/data/chroma
HF_ENDPOINT=https://hf-mirror.com
HF_HOME=/root/.cache/huggingface

# ============================================================
# 拉取已发布镜像（GHCR）时的用法：
#   镜像地址：ghcr.io/<你的用户名>/<仓库名>:latest
#   把 docker-compose.yml 里的 `build: .` 换成
#     image: ghcr.io/<用户名>/<仓库名>:latest
#   其余不变，.env 照旧提供即可。
# ============================================================
