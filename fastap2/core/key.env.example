# 复制为 core/key.env 并填入真实值;真实 key.env 已被 .gitignore 排除
# SECRET_KEY 生成方式: openssl rand -hex 32
SECRET_KEY=
ALGORITHM=HS256

# Redis(限流/缓存用;密码留空 = 无密码模式)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# MCP 工具服务(与 mcp_servers 共用同一个签名密钥)
AGENT_CONTEXT_SECRET=
MCP_ELDER_URL=http://127.0.0.1:8001/mcp
MCP_LIFE_URL=http://127.0.0.1:8002/mcp

# 智能体拓扑:single=单 agent | team=黑板多智能体(supervisor→3专员→aggregate)
AGENT_TOPOLOGY=single
